<?php

/**
 * @file
 * Install and update hooks for the task job module.
 */

use Drupal\task_job\Entity\Job;
use Drupal\task_job\JobVersionId;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Implements hook_schema().
 */
function task_job_schema() {
  $schema = [];

  $schema['task_job_trigger_index'] = [
    'description' => 'Track which triggers are used by which jobs.',
    'fields' => [
      'job' => [
        'description' => 'Job ID.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'trigger' => [
        'description' => 'The trigger plugin id.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'trigger_base' => [
        'description' => 'The trigger base plugin id.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'trigger_key' => [
        'description' => 'The key of the trigger',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'collection' => [
        'description' => 'The config collection of the job',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
    ],
    'primary key' => ['job', 'trigger_key', 'collection'],
    'indexes' => [
      'trigger' => ['trigger'],
      'trigger_base' => ['trigger_base'],
      'job' => ['job'],
      'trigger_key' => ['trigger_key'],
      'collection' => ['collection'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function task_job_install() {
  $definition = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('task')['job'];
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition('job', 'task', 'task_job', $definition);
}

/**
 * Implements hook_uninstall().
 */
function task_job_uninstall() {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($definition = $manager->getFieldStorageDefinition('job', 'task')) {
    $manager->uninstallFieldStorageDefinition($definition);
  }
}

/**
 * Install the job trigger table.
 */
function task_job_update_8001() {
  $schema = [
    'description' => 'Track which triggers are used by which jobs.',
    'fields' => [
      'job' => [
        'description' => 'Job ID.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'trigger' => [
        'description' => 'The trigger plugin id.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'trigger_key' => [
        'description' => 'The key of the trigger',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
    ],
    'primary key' => ['job', 'trigger', 'trigger_key'],
    'indexes' => [
      'trigger' => ['trigger'],
      'job' => ['job'],
      'trigger_key' => ['trigger_key'],
    ],
  ];
  \Drupal::database()->schema()->createTable(
    'task_job_trigger_index',
    $schema
  );
}

/**
 * Add base plugin id to the triggers index table.
 */
function task_job_update_8002() {
  \Drupal::database()->schema()->addField(
    'task_job_trigger_index',
    'trigger_base',
    [
      'description' => 'The trigger base plugin id.',
      'type' => 'varchar',
      'length' => 255,
      'not null' => TRUE,
      'default' => '',
    ]
  );
  \Drupal::database()->schema()->addIndex(
    'task_job_trigger_index',
    'trigger_base',
    ['trigger_base'],
    [
      'fields' => [
        'trigger_base' => [
          'description' => 'The trigger base plugin id.',
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
          'default' => '',
        ],
      ],
    ]
  );
}

/**
 * Add base plugin id to the triggers index table.
 */
function task_job_update_8003() {
  \Drupal::database()->schema()->addField(
    'task_job_trigger_index',
    'collection',
    [
      'description' => 'The config collection of the job.',
      'type' => 'varchar',
      'length' => 255,
      'not null' => TRUE,
      'default' => '',
    ]
  );
  \Drupal::database()->schema()->addIndex(
    'task_job_trigger_index',
    'collection',
    ['collection'],
    [
      'fields' => [
        'collection' => [
          'description' => 'The config collection of the job.',
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
          'default' => '',
        ],
      ],
    ]
  );
}

/**
 * Add collection to the trigger index primary key.
 */
function task_job_update_8004() {
  \Drupal::database()->schema()->dropPrimaryKey('task_job_trigger_index');
  \Drupal::database()->schema()->addPrimaryKey(
    'task_job_trigger_index',
    ['job', 'trigger_key', 'collection']
  );
}

/**
 * Add the named job version to tasks.
 */
function task_job_update_8005() {
  $storage_definition_listener = \Drupal::service('field_storage_definition.listener');
  $definition_listener = \Drupal::service('field_definition.listener');
  $definition = BaseFieldDefinition::create('string')
    ->setName('job_version')
    ->setProvider('task_job')
    ->setTargetEntityTypeId('task')
    ->setLabel(new TranslatableMarkup('Job version'))
    ->setDescription(new TranslatableMarkup('The named job version used by this task.'))
    ->setSetting('max_length', 128)
    ->setInternal(TRUE)
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayConfigurable('form', TRUE);
  $storage_definition_listener->onFieldStorageDefinitionCreate($definition);
  $definition_listener->onFieldDefinitionCreate($definition);
}

/**
 * Converts legacy fallback settings into final unconditional assignment rules.
 */
function task_job_update_8006() {
  $storage = \Drupal::service('config.storage');
  foreach (array_merge([''], $storage->getAllCollectionNames()) as $collection) {
    $collection_storage = $storage->createCollection($collection);
    foreach ($collection_storage->listAll('task_job.task_job.') as $name) {
      $data = $collection_storage->read($name);
      if (!array_key_exists('assignment', $data)) {
        continue;
      }
      $selector = [
        'creator' => 'task.creator.entity',
        'service_manager' => 'task.service.entity.manager.entity',
      ][$data['assignment']] ?? NULL;
      if ($selector) {
        $key = 'default_assignment';
        while (isset($data['assignment_rules'][$key])) {
          $key .= '_';
        }
        $data['assignment_rules'][$key] = [
          'label' => $data['assignment'] === 'creator' ? 'Task creator' : 'Service manager',
          'context_mapping' => ['assignee' => $selector],
        ];
      }
      unset($data['assignment']);
      $data['active_hash'] = Job::definitionHash($data);
      $collection_storage->write($name, $data);
    }
  }
  \Drupal::configFactory()->reset();
  \Drupal::entityTypeManager()->getStorage('task_job')->resetCache();
}

/**
 * Combine configuration job and named version in one typed reference.
 */
function task_job_update_8007() {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $installed = \Drupal::service('entity.last_installed_schema.repository')->getLastInstalledFieldStorageDefinitions('task');
  $storage = \Drupal::entityTypeManager()->getStorage('task');
  $database = \Drupal::database();
  $schema = $database->schema();
  $definition = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('task')['job'];
  $mapping = $storage->getTableMapping($installed);
  $table = $mapping->getFieldTableName('job');

  if ($installed['job']->getType() !== 'task_job_reference') {
    if ($storage->countFieldData($installed['job'], TRUE)) {
      // Retain the old columns until both the copy and metadata update succeed.
      // Retrying interrupted nontransactional DDL safely repeats the copy.
      $new_mapping = $storage->getTableMapping(['job' => $definition] + $installed);
      $columns = $new_mapping->getColumnNames('job');
      foreach ($definition->getColumns() as $property => $specification) {
        if (!$schema->fieldExists($table, $columns[$property])) {
          $schema->addField($table, $columns[$property], $specification);
        }
      }
      $old_column = $mapping->getFieldColumnName($installed['job'], 'target_id');
      $copy = $database->update($table)
        ->fields([$columns['target_type'] => 'task_job'])
        ->expression($columns['target_id'], $old_column)
        ->isNotNull($old_column);
      if (isset($installed['job_version'])) {
        $copy->expression($columns['version'], $mapping->getFieldColumnName($installed['job_version'], 'value'));
      }
      $copy->execute();
      // Older callers sometimes stored the versioned config ID directly.
      // Canonicalize those IDs so typed queries also find the migrated tasks.
      $ids = $database->select($table, 't')->fields('t', [$old_column])
        ->condition($old_column, '%--v%', 'LIKE')->distinct()->execute()->fetchCol();
      foreach ($ids as $id) {
        if ($parts = JobVersionId::parse($id)) {
          $update = $database->update($table)->fields([
            $columns['target_id'] => $parts['job_id'],
            $columns['version'] => $parts['version'],
          ])->condition($old_column, $id);
          $update->condition($update->orConditionGroup()
            ->isNull($columns['version'])->condition($columns['version'], $parts['version']))->execute();
        }
      }
      $definition->setSetting('column_changes_handled', TRUE);
    }
    $manager->updateFieldStorageDefinition($definition);
  }

  // Only discard legacy storage after Drupal records the new reference schema.
  // The original single-column reference was stored as task.job.
  if ($schema->fieldExists($table, 'job')) {
    $schema->dropField($table, 'job');
  }
  if (isset($installed['job_version'])) {
    $column = $mapping->getFieldColumnName($installed['job_version'], 'value');
    $database->update($table)->fields([$column => NULL])->execute();
    $manager->uninstallFieldStorageDefinition($installed['job_version']);
  }
  $storage->resetCache();
}
