<?php

/**
 * @file
 * Task checklist fields, configuration and durable processing requests.
 */

use Drupal\checklist\Entity\ChecklistItemInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\entity\BundleFieldDefinition;
use Drupal\task\Entity\Task;

/**
 * Implements hook_entity_base_field_info().
 */
function task_checklist_entity_base_field_info(EntityTypeInterface $entity_type) {
  $fields = [];

  if ($entity_type->id() == 'task') {
    // Use bundle field definition to avoid this going on the main task table.
    $fields['checklist'] = BundleFieldDefinition::create('checklist')
      ->setLabel(new TranslatableMarkup('Checklist'))
      ->setDisplayOptions('view', [
        'type' => 'checklist_interactive',
      ])
      ->setDisplayConfigurable('view', TRUE)
      ->setDisplayConfigurable('form', TRUE);
  }

  return $fields;
}

/**
 * Implements hook_form_task_configuration_form_alter().
 */
function task_checklist_form_task_configuration_form_alter(array &$form, FormStateInterface $form_state) {
  $form['task_checklist'] = [
    '#type' => 'details',
    '#title' => new TranslatableMarkup('Checklist Settings'),
    '#open' => TRUE,
    '#tree' => TRUE,
  ];
  $form['task_checklist']['ci_name_prefix'] = [
    '#type' => 'textfield',
    '#title' => new TranslatableMarkup('Default Name Prefix'),
    '#description' => new TranslatableMarkup('All checklist items must have a name that is unique with the checklist. This field sets an automatic prefix on those names to ease configuration'),
    '#default_value' => \Drupal::configFactory()->get('task_checklist.defaults')->get('ci_name_prefix'),
  ];

  $form['actions']['submit']['#submit'][] = 'task_checklist_form_task_configuration_form_submit';
}

/**
 * Submit to save task checklist settings.
 *
 * @param array $form
 *   The task configuration form.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The submitted form state.
 */
function task_checklist_form_task_configuration_form_submit(array $form, FormStateInterface $form_state) {
  \Drupal::configFactory()->getEditable('task_checklist.defaults')
    ->set('ci_name_prefix', $form_state->getValue(['task_checklist', 'ci_name_prefix']))
    ->save();
}

/**
 * Implements hook_task_update().
 */
function task_checklist_task_update(Task $task) {
  _task_checklist_request($task);
}

/**
 * Implements hook_task_insert().
 */
function task_checklist_task_insert(Task $task) {
  _task_checklist_request($task);
}

/**
 * Records active work; the worker rechecks the candidate account's access.
 */
function _task_checklist_request(Task $task): void {
  if (!$task->isNew() && $task->isDefaultRevision() && $task->status->value === 'active' && !$task->checklist->isEmpty()) {
    $executor = (int) (\Drupal::currentUser()->id() ?: $task->creator->target_id);
    if ($executor > 0) {
      \Drupal::service('task_checklist.request_storage')->request((int) $task->id(), $task->uuid(), $executor);
    }
  }
}

/**
 * Implements hook_checklist_item_insert().
 */
function task_checklist_checklist_item_insert(ChecklistItemInterface $item): void {
  _task_checklist_item_changed($item);
}

/**
 * Implements hook_checklist_item_update().
 */
function task_checklist_checklist_item_update(ChecklistItemInterface $item): void {
  $original = $item->original;
  if ($item->get('status')->getValue() !== $original->get('status')->getValue()
    || $item->get('outcomes')->getValue() !== $original->get('outcomes')->getValue()) {
    _task_checklist_item_changed($item);
  }
}

/**
 * Wakes the main task checklist when persisted item results change.
 */
function _task_checklist_item_changed(ChecklistItemInterface $item): void {
  $reference = $item->get('checklist');
  if ($reference->getFieldDefinition()->getSetting('target_type') === 'task'
    && in_array($reference->checklist_key, ['checklist', 'checklist:0'], TRUE)
    && $reference->target_id) {
    $task = \Drupal::entityTypeManager()->getStorage('task')->loadUnchanged($reference->target_id);
    if ($task) {
      _task_checklist_request($task);
    }
  }
}

/**
 * Implements hook_task_delete().
 */
function task_checklist_task_delete(Task $task): void {
  \Drupal::service('task_checklist.request_storage')->delete($task->uuid());
}

/**
 * Implements hook_cron().
 */
function task_checklist_cron(): void {
  \Drupal::service('task_checklist.scheduler')->dispatch();
}
