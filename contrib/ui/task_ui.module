<?php

/**
 * @file
 * Views presentation and progressive enhancement for task workspaces.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\task_ui\Form\WorkspaceForms;

/**
 * Implements hook_views_data_alter().
 */
function task_ui_views_data_alter(array &$data): void {
  // Drupal 10 does not enable empty operators on optional base fields.
  $data['task']['assignee']['filter']['allow empty'] = TRUE;
  foreach ([
    'open' => ['Task workspace link', 'title'],
    'state' => ['Current readiness', 'id'],
    'assignee' => ['Task assignee', 'assignee'],
    'context' => ['Task context', 'id'],
    'due' => ['Task due date', 'due'],
    'deadline' => ['Task external deadline', 'deadline'],
    'actions' => ['Task workspace actions', 'id'],
  ] as $component => [$title, $column]) {
    $data['task']['task_ui_' . $component] = [
      'title' => $title,
      'field' => ['id' => 'task_ui_detail', 'component' => $component, 'real field' => $column],
    ];
  }
  $data['task']['task_ui_assignee']['filter'] = ['id' => 'task_ui_assignee', 'real field' => 'assignee'];
}

/**
 * Implements hook_form_alter().
 */
function task_ui_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  WorkspaceForms::alter($form, $form_state);
}

/**
 * Implements hook_form_views_exposed_form_alter().
 */
function task_ui_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state): void {
  $view = $form_state->get('view');
  if ($view->id() === 'task_workspace') {
    $form['queue'] = ['#type' => 'hidden', '#value' => $view->current_display];
  }
}

/**
 * Implements hook_preprocess_views_view().
 */
function task_ui_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  if ($view->id() === 'task_workspace') {
    // Preserve applied inputs, not edits to an unsubmitted exposed form.
    $input = $view->getExposedInput();
    $input['page'] = $view->getCurrentPage();
    $variables['attributes']['data-task-view-input'] = json_encode($input);
  }
}
