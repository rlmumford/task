<?php

/**
 * @file
 * Bridges source transitions to job creation's existing consumer.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;

/**
 * Implements hook_entity_update().
 */
function task_dependency_job_entity_update(EntityInterface $entity): void {
  if (!$entity instanceof FieldableEntityInterface || !isset($entity->original) || $entity->getEntityTypeId() === 'task_dependency'
    || ($entity instanceof ContentEntityInterface && !$entity->isDefaultRevision())) {
    return;
  }
  $ids = ['dependency_event:entity.state:' . $entity->getEntityTypeId()];
  if ($entity->getEntityTypeId() === 'task') {
    $ids[] = 'dependency_event:task.resolved';
  }
  foreach ($ids as $id) {
    \Drupal::service('plugin.manager.task_job.trigger')->handleTrigger($id, [
      ($id === 'dependency_event:task.resolved' ? 'task' : 'entity') => $entity,
      'original' => $entity->original,
    ]);
  }
}
